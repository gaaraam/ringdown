{
  "name": "ringdown",
  "version": "0.1.0",
  "private": true,
  "description": "조직마다 다른 지식·정책·업무 시스템에 AI 콜 에이전트를 설정 묶음 하나로 연결하는 엔진",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ringdown": "./src/cli.ts"
  },
  "scripts": {
    "ringdown": "tsx src/cli.ts",
    "validate": "tsx src/cli.ts validate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundary": "tsx scripts/check-boundary.ts",
    "ci": "npm run typecheck && npm run test && npm run check:boundary && npm run validate && npm run soundcheck:smoke",
    "soundcheck": "tsx src/cli.ts soundcheck",
    "soundcheck:smoke": "tsx scripts/soundcheck-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
